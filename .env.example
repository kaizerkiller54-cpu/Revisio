# Base de données PostgreSQL (local ou managé)
DATABASE_URL="postgresql://revisio:VOTRE_MOT_DE_PASSE@localhost:5432/revisio?schema=public"

# Supabase - Remplacez <ref> par votre Project Reference (ex: fmeuipgortpizaluiyuh)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="eyJ_VOTRE_ANON_KEY_ICI"
SUPABASE_SERVICE_ROLE_KEY="eyJ_VOTRE_SERVICE_ROLE_KEY_ICI"
SUPABASE_JWT_SECRET="VOTRE_JWT_SECRET_BASE64_ICI"

# Serveur
PORT=3000
NODE_ENV=development

# SuperAdmin bootstrap (changez en production !)
SUPERADMIN_MASTER_KEY="VOTRE_CLE_MASTER_UNIQUE_ICI"

# Rate limiting : "true" (défaut) en temps normal.
# "false" UNIQUEMENT en local et temporairement (ex. import en masse).
# NE JAMAIS mettre "false" en production.
# RATE_LIMIT_ENABLED="true"